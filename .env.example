# fly-retro-nose configuration — copy to .env and fill in.
# .env is gitignored; never commit real tokens.

# ---------------------------------------------------------------------------
# neuPrint (only needed to regenerate data/male_cns_pn_kc.npz from the
# male-CNS connectome; not needed if data/ already exists)
# ---------------------------------------------------------------------------
NEUPRINT_TOKEN=

# ---------------------------------------------------------------------------
# Corpus source (nano-workforce SQLite app.db, read-only)
#   unset => ~/workspace/nano-workforce/app.db
# ---------------------------------------------------------------------------
# FLY_NWF_DB=/path/to/app.db

# ---------------------------------------------------------------------------
# Clustering knobs (corpus size affects the ideal threshold)
#   FLY_HASH_LENGTH  Kenyon cells kept per tag   (default 96)
#   FLY_THRESHOLD    agglomerative distance      (default 0.90; ~0.80 for a
#                    larger, more diverse corpus)
#   FLY_MIN_FAMILY   min members to form a family (default 2)
# ---------------------------------------------------------------------------
# FLY_HASH_LENGTH=96
# FLY_THRESHOLD=0.90
# FLY_MIN_FAMILY=2

# ---------------------------------------------------------------------------
# LLM tiers (all optional; every path degrades gracefully if unset/unreachable)
#
# The fly (deterministic, O(1)) does retrieval/clustering/novelty. LLMs only
# do language:
#   small tier    -> always-on per-family distillation + plan-time phrasing.
#                    A "less capable" local model is fine.
#   frontier tier -> optional periodic deep synthesis in the report only.
# ---------------------------------------------------------------------------

# small tier (OpenAI-compatible: llama.cpp, Ollama, LM Studio, ...)
# FLY_LLM_URL=http://localhost:11434       # unset => extractive fallback
# FLY_LLM_MODEL=qwen2.5:1.5b
# FLY_LLM_KEY=                              # optional bearer token
# FLY_LLM_TIMEOUT=60

# frontier tier (a more capable local or hosted model)
# FLY_FRONTIER_URL=https://api.openai.com  # unset => no synthesis section
# FLY_FRONTIER_MODEL=gpt-4o
# FLY_FRONTIER_KEY=                         # e.g. $OPENAI_API_KEY
# FLY_FRONTIER_TIMEOUT=60                   # raise for slow/reasoning models
